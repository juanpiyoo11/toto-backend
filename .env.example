# JWT Configuration
# Generate a secure 512-bit (64 character) secret key for HS512
# Example: openssl rand -base64 64
JWT_SECRET=changeme-this-is-a-very-long-secret-key-for-jwt-signing-minimum-512-bits-please-replace-in-production

# Database Configuration
DATABASE_URL=jdbc:postgresql://localhost:5432/toto
DATABASE_USERNAME=toto
DATABASE_PASSWORD=toto123

# CORS Configuration (comma-separated origins for mobile app development)
CORS_ALLOWED_ORIGINS=http://localhost:19006,http://localhost:8081,http://10.0.2.2:8081

# Server Port (optional, defaults to 8080)
PORT=8080

# OpenAI API Configuration (existing)
OPENAI_API_KEY=your-openai-api-key

# WhatsApp API Configuration (existing)
WHATSAPP_TOKEN=your-whatsapp-token
WHATSAPP_PHONE_ID=your-phone-id
WHATSAPP_VERIFY_TOKEN=your-verify-token

# Spotify API Configuration (existing)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
